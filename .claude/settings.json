{
  "$schema": "https://www.schemastore.org/claude-code-settings.json",
  "env": {
    "ENABLE_TOOL_SEARCH": "true"
  },
  "permissions": {
    "allow": [
      "Bash(npm test *)",
      "Bash(npm run typecheck *)",
      "Bash(npm run build *)",
      "Bash(npm run validate *)",
      "Bash(npm run inspect *)",
      "Bash(npm run dev *)",
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npm ls *)",
      "Bash(npm audit)",
      "Bash(npx vitest run *)",
      "Bash(npm run e2e *)",
      "Bash(npx playwright test *)",
      "Bash(npx playwright install *)",
      "Bash(npx playwright show-report *)",
      "Bash(open http://localhost:5175*)",
      "Bash(npx tsc *)",
      "Bash(npx tsx scripts/*)",
      "Bash(npx tsx .claude/*)",
      "Bash(.claude/*)",
      "Bash(bash .claude/*)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git blame *)",
      "Bash(git ls-files *)",
      "Bash(git ls-remote *)",
      "Bash(git rev-parse *)",
      "Bash(git remote -v)",
      "Bash(git fetch *)",
      "Bash(git stash list)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(gh auth status)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(sed -n *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(tr *)",
      "Bash(diff *)",
      "Bash(du *)",
      "Bash(file *)",
      "Bash(which *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(pwd)",
      "Bash(date *)",
      "Bash(true)",
      "Bash(jq *)",
      "Bash(lsof *)",
      "Bash(nc -z *)",
      "Bash(mkdir -p *)",
      "Bash(chmod +x *)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "WebFetch(domain:threejs.org)",
      "WebFetch(domain:vitest.dev)",
      "WebFetch(domain:vite.dev)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:code.claude.com)",
      "mcp__claude-in-chrome__tabs_context_mcp",
      "ClaudeInChromeDomain(localhost:5175)"
    ],
    "deny": [
      "Read(./public/**/*.mp3)",
      "Read(./public/**/*.glb)",
      "Read(./assets/source/**)",
      "Read(./assets/converted/**)",
      "Read(./dist/**)",
      "Read(./package-lock.json)",
      "Edit(./public/music/**)",
      "Edit(./public/cars/**)",
      "Edit(./public/parts/**)",
      "Edit(./src/assets/musicCatalog.json)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(npm publish *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(rm -rf *)",
      "Bash(npm run assets *)",
      "Bash(npm run music *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__blender__execute_blender_code",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-blender-code.sh",
            "timeout": 10,
            "statusMessage": "Checking Blender code for known crashers"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-json.sh",
            "if": "Edit(**/*.json)",
            "timeout": 60,
            "statusMessage": "Validating JSON data file"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-scss.sh",
            "if": "Edit(**/*.scss)",
            "timeout": 30,
            "statusMessage": "Compiling the stylesheet"
          }
        ]
      }
    ]
  }
}
