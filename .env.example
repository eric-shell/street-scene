# Accounts (Google sign-in + Neon). Copy to .env.local for `npm run dev`; set the same on Vercel.
# Leave VITE_GOOGLE_CLIENT_ID empty and the game builds without accounts (no Account tab, no requests).

# OAuth client id (Google Cloud → APIs & Services → Credentials → OAuth client ID → Web application).
# Inlined into the page at build time (VITE_) and checked by api/account.ts as the token's audience.
VITE_GOOGLE_CLIENT_ID=

# Neon connection string (the Vercel ↔ Neon integration sets this for you).
DATABASE_URL=

# Signs the session cookie: `openssl rand -base64 48`. Rotating it signs everyone out.
SESSION_SECRET=

# Comma separated emails allowed to sign in. Empty lets nobody in.
ALLOWED_EMAILS=

# Comma separated emails that may open the analytics dashboard (/dashboard). Must also be able to sign in
# (ALLOWED_EMAILS). Empty lets nobody in.
ADMIN_EMAILS=

# Authorizes the daily retention pass (Vercel Cron sends it as a Bearer token): `openssl rand -base64 32`.
# Unset, the pass refuses to run.
CRON_SECRET=

# Optional: Upstash Redis for the analytics beacon's shared rate limit (api/_lib/rateLimit.ts). The Vercel
# marketplace integration injects KV_REST_API_URL / KV_REST_API_TOKEN instead; either pair works. Unset, the
# limit is per warm instance only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
